def load_omnisafe_checkpoint(checkpoint_path: Path) -> Tuple[torch.nn.Module, Dict]:
    print(f"\n📦 Loading checkpoint: {checkpoint_path}")
    
    if not checkpoint_path.exists():
        raise FileNotFoundError(f"Checkpoint not found: {checkpoint_path}")
    
    checkpoint = torch.load(checkpoint_path, map_location='cpu')
    
    print(f"✅ Checkpoint loaded")
    print(f"   Keys: {list(checkpoint.keys())}")
    
    if 'actor' in checkpoint:
        actor_state = checkpoint['actor']
    elif 'actor_critic' in checkpoint:
        actor_state = checkpoint['actor_critic']
        if hasattr(actor_state, 'actor'):
            actor_state = actor_state.actor
    else:
        for key in checkpoint.keys():
            if 'actor' in key.lower() or 'policy' in key.lower():
                actor_state = checkpoint[key]
                break
        else:
            raise KeyError("Cannot find actor/policy in checkpoint. Keys: " + str(checkpoint.keys()))
    
    info = {
        'epoch': checkpoint.get('epoch', 99),
        'total_steps': checkpoint.get('total_steps', checkpoint.get('step', 'unknown')),
    }
    
    if 'Metrics/EpCost' in checkpoint:
        info['episode_cost'] = checkpoint['Metrics/EpCost']
    if 'Metrics/EpRet' in checkpoint:
        info['episode_reward'] = checkpoint['Metrics/EpRet']
    if 'Metrics/LagrangeMultiplier' in checkpoint:
        info['lambda'] = checkpoint['Metrics/LagrangeMultiplier']
    
    print(f"\n📊 Checkpoint Info:")
    for key, val in info.items():
        print(f"   {key}: {val}")
    
    return actor_state, info


def create_policy_fn(actor_model, device='cpu'):
    actor_model.eval()
    actor_model.to(device)
    
    @torch.no_grad()
    def policy_fn(obs: np.ndarray, deterministic: bool = True) -> np.ndarray:
        obs_tensor = torch.FloatTensor(obs).unsqueeze(0).to(device)
        
        if hasattr(actor_model, 'forward'):
            try:
                action_tensor = actor_model(obs_tensor)
                if deterministic:
                    if hasattr(action_tensor, 'mean'):
                        action_tensor = action_tensor.mean
                    elif isinstance(action_tensor, tuple):
                        action_tensor = action_tensor[0]
            except Exception as e:
                print(f"⚠️  Direct forward failed: {e}")
                if hasattr(actor_model, 'act'):
                    action_tensor = actor_model.act(obs_tensor, deterministic=deterministic)
                else:
                    raise
        elif hasattr(actor_model, 'act'):
            action_tensor = actor_model.act(obs_tensor, deterministic=deterministic)
        else:
            raise AttributeError("Actor model has no 'forward' or 'act' method")
        
        if isinstance(action_tensor, tuple):
            action_tensor = action_tensor[0]
        
        action = action_tensor.cpu().numpy().squeeze()
        
        return action
    
    return policy_fn


# ============================================================================
# EVALUATION
# ============================================================================

def evaluate_trained_model(policy_fn, env: CityLearnSafetyEnvV3, log_actions: bool = True, seed: int = 42) -> pd.DataFrame:
    print(f"\n🎮 Starting evaluation episode...")
    print(f"   Logging actions: {log_actions}")
    print(f"   Seed: {seed}")
    
    obs, info = env.reset(seed=seed)
    
    episode_data = []
    episode_cost = 0
    episode_reward = 0
    step_count = 0
    
    done = False
    truncated = False
    
    action_dim = env.action_space.shape[0]
    print(f"   Action space: {action_dim}")
    
    while not (done or truncated):
        action = policy_fn(obs, deterministic=True)
        action = np.clip(action, -1.0, 1.0)
        
        obs, reward, done, truncated, info = env.step(action)
        
        step_data = {
            'step': step_count,
            'reward': reward,
            'done': int(done),
            'truncated': int(truncated),
        }
        
        if log_actions:
            for i in range(action_dim):
                step_data[f'action_{i}'] = action[i]
            
            for i in range(min(17, action_dim)):
                step_data[f'action_battery_b{i}'] = action[i]
            
            if action_dim > 17:
                for i in range(17, min(25, action_dim)):
                    step_data[f'action_ev_{i-17}'] = action[i]
            
            if action_dim == 26:
                step_data['action_washing_machine'] = action[25]
            
            if action_dim == 60:
                for i in range(25, 42):
                    step_data[f'action_heating_b{i-25}'] = action[i]
                for i in range(42, 59):
                    step_data[f'action_cooling_b{i-42}'] = action[i]
                step_data['action_washing_machine'] = action[59]
        
        for key, value in info.items():
            step_data[key] = value
        
        episode_data.append(step_data)
        
        episode_cost += info.get('cost', 0)
        episode_reward += reward
        step_count += 1
        
        if step_count % 1000 == 0:
            print(f"   Step {step_count}/8759: Cost={episode_cost:.2f}, Reward={episode_reward:.2f}")
    
    print(f"\n✅ Episode complete!")
    print(f"   Total steps: {step_count}")
    print(f"   Total cost: {episode_cost:.2f}")
    print(f"   Total reward: {episode_reward:.2f}")
    
    df = pd.DataFrame(episode_data)
    
    return df


