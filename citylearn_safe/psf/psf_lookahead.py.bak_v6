from __future__ import annotations
import os, time
from typing import Any, Dict, Tuple
import numpy as np
import cvxpy as cp
import gymnasium as gym

from .psf_extract import unwrap_to_citylearn, flatten_action, unflatten_action


class LookaheadPSFWrapper(gym.Wrapper):
    """
    Predictive Safety Filter using parametric MPC-style QP (DPP-compliant).
    Problem compiled once, only cp.Parameter values updated each step.
    """

    def __init__(self, env, horizon: int = 24,
                 soc_low=None, soc_high=None,
                 p_building_max=None, p_grid_max=None,
                 ev_efficiency: float = 0.95,
                 w_track: float = 100.0,
                 w_slack_c1: float = 1000.0,
                 w_slack_c3: float = 10.0,
                 w_slack_c4: float = 10.0,
                 w_future_reg: float = 0.01,
                 exempt_ev_from_c3: bool = False,
                 freeze_ev: bool = False,
                 verbose: int = 0):
        super().__init__(env)
        self.horizon = horizon
        self.soc_low = soc_low if soc_low is not None else float(os.environ.get("CITYLEARN_STEMS_SOC_LOW", "0.0"))
        self.soc_high = soc_high if soc_high is not None else float(os.environ.get("CITYLEARN_STEMS_SOC_HIGH", "0.95"))
        self.p_building_max = p_building_max if p_building_max is not None else float(os.environ.get("CITYLEARN_STEMS_P_BUILDING_MAX", "3.47"))
        self.p_grid_max = p_grid_max if p_grid_max is not None else float(os.environ.get("CITYLEARN_STEMS_P_GRID_MAX", "35.76"))
        self.ev_efficiency = ev_efficiency
        self.w_track = w_track
        self.w_slack_c1 = w_slack_c1
        self.w_slack_c3 = w_slack_c3
        self.w_slack_c4 = w_slack_c4
        self.w_future_reg = w_future_reg
        self.exempt_ev_from_c3 = exempt_ev_from_c3
        self.freeze_ev = freeze_ev
        self.verbose = verbose
        self._prob = None
        self._compiled = False
        self._mapping = None
        self._step_count = 0
        self._episode_count = 0
        self._total_interventions = 0
        self._total_ev_interventions = 0
        self._total_batt_interventions = 0
        self._total_grid_interventions = 0
        self._grid_error_ema = 0.0
        self._total_solve_ms = 0.0
        self._infeasible_count = 0
        self._grid_error_ema = 0.0
        self._prev_grid_predicted = None

    def _get_citylearn_env(self):
        return unwrap_to_citylearn(self.env)

    def _build_mapping(self):
        city = self._get_citylearn_env()
        names_raw = getattr(city, "action_names", [])
        buildings = getattr(city, "buildings", [])
        nb = len(buildings)
        m = {"agent_dims": [], "batt_gidx": [], "ev_chargers": [], "gidx_to_building": {}}

        # --- Detect central_agent mode: single sub-list with all actions flattened ---
        is_central = (len(names_raw) == 1 and isinstance(names_raw[0], list)
                      and nb > 1 and len(names_raw[0]) > nb)

        if is_central:
            flat_names = names_raw[0]
            # Find battery positions — they appear in building order
            batt_positions = [i for i, n in enumerate(flat_names)
                              if str(n).lower() == "electrical_storage"]

            if len(batt_positions) == nb:
                # Reconstruct per-building sub-lists from battery positions
                reconstructed = []
                for b_idx in range(nb):
                    start = batt_positions[b_idx]
                    end = batt_positions[b_idx + 1] if b_idx + 1 < nb else len(flat_names)
                    reconstructed.append(list(flat_names[start:end]))
                names_raw = reconstructed
                print("[PSF] central_agent detected: reconstructed %d buildings from flat action list" % nb)
            else:
                print("[PSF] WARNING: central_agent detected but battery count (%d) != building count (%d)" %
                      (len(batt_positions), nb))

        # --- Standard per-building mapping (works for both modes now) ---
        g = 0
        for b_idx, sub in enumerate(names_raw):
            if not isinstance(sub, list):
                sub = [sub]
            m["agent_dims"].append(len(sub))
            batt_found = False
            for n in sub:
                n_str = str(n).lower()
                m["gidx_to_building"][g] = b_idx
                if n_str == "electrical_storage" and not batt_found:
                    m["batt_gidx"].append(g)
                    batt_found = True
                if "electric_vehicle_storage_charger_" in n_str:
                    m["ev_chargers"].append({"gidx": g, "b_idx": b_idx})
                g += 1
            if not batt_found:
                m["batt_gidx"].append(-1)
        m["total_dim"] = g
        return m

    def _compile_qp(self):
        """Build DPP-compliant parametric QP. All param*var products use
        pre-computed single parameters to avoid param*param*var."""
        city = self._get_citylearn_env()
        self._mapping = self._build_mapping()
        self._nb = len(city.buildings)
        nb = self._nb
        H = self.horizon
        self._batt_list = [(b_idx, g) for b_idx, g in enumerate(self._mapping["batt_gidx"]) if g >= 0]
        n_batt = len(self._batt_list)
        self._n_batt = n_batt
        self._max_ev = len(self._mapping["ev_chargers"])
        n_ev = self._max_ev

        self._batt_by_bldg = {}
        for bi, (b_idx, g) in enumerate(self._batt_list):
            self._batt_by_bldg[b_idx] = bi
        self._ev_by_bldg = {}
        for ei, evc in enumerate(self._mapping["ev_chargers"]):
            self._ev_by_bldg.setdefault(evc["b_idx"], []).append(ei)

        # Variables
        self._v_a_batt = cp.Variable((n_batt, H))
        self._v_a_ev = cp.Variable((n_ev, H)) if n_ev > 0 else None
        self._v_slack_c3 = cp.Variable((nb, H), nonneg=True)
        self._v_slack_c4 = cp.Variable(H, nonneg=True)
        self._v_slack_c1 = cp.Variable(n_ev, nonneg=True) if n_ev > 0 else None
        self._v_imp = cp.Variable((nb, H), nonneg=True)
        self._p_grid_limit = cp.Parameter(value=float(self.p_grid_max), nonneg=True)

        # Parameters — all single params, no products of params in constraints
        self._p_proposed_batt = cp.Parameter(n_batt, value=np.zeros(n_batt))
        self._p_proposed_ev = cp.Parameter(n_ev, value=np.zeros(n_ev)) if n_ev > 0 else None
        self._p_soc0 = cp.Parameter(n_batt, value=np.zeros(n_batt))
        self._p_soc_scale = cp.Parameter(n_batt, value=np.ones(n_batt), pos=True)
        self._p_base_net = cp.Parameter((nb, H), value=np.zeros((nb, H)))
        self._p_batt_gain = cp.Parameter(n_batt, value=np.ones(n_batt), pos=True)
        # Pre-computed: ev_gain[ei,k] = max_p * active_flag (single param, not product)
        if n_ev > 0:
            self._p_ev_gain = cp.Parameter((n_ev, H), value=np.zeros((n_ev, H)), nonneg=True)
            # Pre-computed: c1_coeff[ei,k] = max_p * tau_mask * efficiency
            self._p_ev_c1_coeff = cp.Parameter((n_ev, H), value=np.zeros((n_ev, H)), nonneg=True)
            self._p_ev_deficit = cp.Parameter(n_ev, value=np.zeros(n_ev), nonneg=True)
            # Frozen EV power per building per step (added to base_net when freeze_ev=True)
            self._p_frozen_ev_power = cp.Parameter((nb, H), value=np.zeros((nb, H)))

        constraints = []
        constraints += [self._v_a_batt >= -1.0, self._v_a_batt <= 1.0]
        if n_ev > 0:
            constraints += [self._v_a_ev >= 0.0, self._v_a_ev <= 1.0]

        # C2: SoC bounds — cumulative sum of actions * scale
        for bi in range(n_batt):
            for k in range(H):
                soc_k = self._p_soc0[bi] + cp.sum(self._v_a_batt[bi, :k+1]) * self._p_soc_scale[bi]
                constraints += [soc_k >= self.soc_low, soc_k <= self.soc_high]

        # Accumulate net_full per timestep for C4
        _net_full_by_k = {k: [] for k in range(H)}

        # C3 + C4: net power per building
        # freeze_ev: EV power in base_net, a_ev has zero gain (QP ignores EVs)
        # exempt_ev_from_c3: C3 excludes EV, C4 includes EV
        for b_idx in range(nb):
            for k in range(H):
                # Base + frozen EV power + battery
                net_base_batt = self._p_base_net[b_idx, k]
                if n_ev > 0:
                    net_base_batt = net_base_batt + self._p_frozen_ev_power[b_idx, k]
                if b_idx in self._batt_by_bldg:
                    bi = self._batt_by_bldg[b_idx]
                    net_base_batt = net_base_batt + self._v_a_batt[bi, k] * self._p_batt_gain[bi]
                # Add QP-controlled EV (only active when NOT frozen)
                net_full = net_base_batt
                if n_ev > 0:
                    for ei in self._ev_by_bldg.get(b_idx, []):
                        net_full = net_full + self._v_a_ev[ei, k] * self._p_ev_gain[ei, k]
                # C3
                if self.exempt_ev_from_c3 or self.freeze_ev:
                    net_c3 = net_base_batt
                else:
                    net_c3 = net_full
                constraints += [
                    net_c3 <= self.p_building_max + self._v_slack_c3[b_idx, k],
                    net_c3 >= -self.p_building_max - self._v_slack_c3[b_idx, k],
                ]
                # C4: accumulate net_full for grid sum constraint
                _net_full_by_k[k].append(net_full)

        # C4 grid — symmetric constraint on actual sum of all building net power
        for k in range(H):
            grid_sum_k = sum(_net_full_by_k[k])  # sum of cvxpy expressions
            constraints += [grid_sum_k <= self._p_grid_limit + self._v_slack_c4[k]]
            constraints += [grid_sum_k >= -self._p_grid_limit - self._v_slack_c4[k]]

        # C1: EV deadline — energy = sum(a_ev[ei,k] * c1_coeff[ei,k])
        if n_ev > 0:
            for ei in range(n_ev):
                energy = cp.sum(cp.multiply(self._v_a_ev[ei, :], self._p_ev_c1_coeff[ei, :]))
                constraints += [energy >= self._p_ev_deficit[ei] - self._v_slack_c1[ei]]

        # Objective
        obj = self.w_track * cp.sum_squares(self._v_a_batt[:, 0] - self._p_proposed_batt)
        if n_ev > 0:
            obj += self.w_track * cp.sum_squares(self._v_a_ev[:, 0] - self._p_proposed_ev)
            obj += self.w_slack_c1 * cp.sum(self._v_slack_c1)
        obj += self.w_slack_c3 * cp.sum(self._v_slack_c3)
        obj += self.w_slack_c4 * cp.sum(self._v_slack_c4)
        if H > 1:
            obj += self.w_future_reg * cp.sum_squares(self._v_a_batt[:, 1:])
            if n_ev > 0:
                obj += self.w_future_reg * cp.sum_squares(self._v_a_ev[:, 1:])

        self._prob = cp.Problem(cp.Minimize(obj), constraints)
        assert self._prob.is_dpp(), "Problem must be DPP for fast parametric solves!"
        self._compiled = True
        if self.verbose >= 1:
            print("[PSF-QP] Compiled DPP: %d batt, %d ev, H=%d, %d vars, %d constraints" % (
                n_batt, n_ev, H, sum(v.size for v in self._prob.variables()),
                len(constraints)))

    def _update_params_and_solve(self, proposed_flat):
        t0 = time.time()
        city = self._get_citylearn_env()
        buildings = list(getattr(city, "buildings", []))
        H = self.horizon
        t_now = int(getattr(city, "time_step", 0))
        t_idx = max(0, t_now - 1)

        # Battery params
        soc0 = np.zeros(self._n_batt)
        soc_scale = np.ones(self._n_batt)
        batt_gain = np.ones(self._n_batt)
        proposed_batt = np.zeros(self._n_batt)
        for bi, (b_idx, gidx) in enumerate(self._batt_list):
            es = getattr(buildings[b_idx], "electrical_storage", None)
            cap = float(getattr(es, "capacity", 6.4))
            nom_p = float(getattr(es, "nominal_power", 5.0))
            soc_arr = np.asarray(getattr(es, "soc", []), dtype=float)
            soc0[bi] = float(np.clip(soc_arr[t_idx], 0.0, 1.0)) if 0 <= t_idx < len(soc_arr) else 0.5
            soc_scale[bi] = nom_p / cap
            batt_gain[bi] = nom_p
            proposed_batt[bi] = float(proposed_flat[gidx])
        self._p_soc0.value = soc0
        self._p_soc_scale.value = soc_scale
        self._p_batt_gain.value = batt_gain
        self._p_proposed_batt.value = proposed_batt

        # Base net forecast
        base_net = np.zeros((self._nb, H))
        for b_idx, b in enumerate(buildings):
            raw_nsl = np.asarray(getattr(b, "_Building__energy_to_non_shiftable_load", []), dtype=float)
            raw_sg = np.asarray(getattr(b, "_Building__solar_generation", []), dtype=float)
            T_max = min(len(raw_nsl), len(raw_sg))
            for k in range(H):
                idx = t_now + k
                if idx < T_max:
                    base_net[b_idx, k] = raw_nsl[idx] + raw_sg[idx]
                elif T_max > 0:
                    base_net[b_idx, k] = raw_nsl[T_max-1] + raw_sg[T_max-1]
        self._p_base_net.value = base_net

        # EV params — read from charger_simulation (correct source for dep/req_soc)
        if self._max_ev > 0:
            ev_gain = np.zeros((self._max_ev, H))
            ev_c1_coeff = np.zeros((self._max_ev, H))
            ev_deficit = np.zeros(self._max_ev)
            proposed_ev = np.zeros(self._max_ev)

            for ei, evc in enumerate(self._mapping["ev_chargers"]):
                b_idx = evc["b_idx"]
                gidx = evc["gidx"]
                proposed_ev[ei] = float(proposed_flat[gidx]) if gidx < len(proposed_flat) else 0.0

                b = buildings[b_idx]
                chargers = getattr(b, "electric_vehicle_chargers", None) or []
                ev_in_bldg = [e for e in self._mapping["ev_chargers"] if e["b_idx"] == b_idx]
                local_idx = next((li for li, e in enumerate(ev_in_bldg) if e["gidx"] == gidx), None)
                if local_idx is None or local_idx >= len(chargers):
                    continue
                ch = chargers[local_idx]

                # Max charging power
                max_p = getattr(ch, "max_charging_power",
                                getattr(ch, "_Charger__max_charging_power", 0))
                if isinstance(max_p, np.ndarray):
                    max_p = float(max_p.ravel()[0])
                elif max_p is not None:
                    max_p = float(max_p)
                else:
                    max_p = 0.0

                # Read from charger_simulation (the CORRECT source)
                sim = getattr(ch, "charger_simulation",
                              getattr(ch, "_Charger__charger_simulation", None))
                if sim is None:
                    continue

                try:
                    state_arr = np.asarray(
                        getattr(sim, "_electric_vehicle_charger_state"), dtype=float)
                    dep_arr = np.asarray(
                        getattr(sim, "_electric_vehicle_departure_time"), dtype=float)
                    req_arr = np.asarray(
                        getattr(sim, "_electric_vehicle_required_soc_departure"), dtype=float)
                    ev_id_arr = getattr(sim, "_electric_vehicle_id")
                except (AttributeError, TypeError):
                    continue

                if t_now >= len(state_arr):
                    continue
                if float(state_arr[t_now]) != 1.0:
                    continue
                if ev_id_arr[t_now] is None:
                    continue

                # Departure time (steps remaining)
                dep_raw = float(dep_arr[t_now])
                tau = 999
                if np.isfinite(dep_raw):
                    tau = max(1, int(dep_raw))

                # Required SoC
                req_soc = float(req_arr[t_now])
                if not np.isfinite(req_soc):
                    req_soc = 1.0

                # Current EV SoC
                ev_soc = 0.0
                ev_cap = 0.0
                ev_obj = getattr(ch, "connected_electric_vehicle", None)
                if ev_obj is not None:
                    batt = getattr(ev_obj, "battery", None)
                    if batt is not None:
                        ev_cap = float(getattr(batt, "capacity", 0) or 0)
                        soc_data = getattr(batt, "soc", None)
                        if soc_data is not None:
                            soc_np = np.asarray(soc_data, dtype=float)
                            if 0 <= t_idx < len(soc_np):
                                ev_soc = float(np.clip(soc_np[t_idx], 0.0, 1.0))

                ev_deficit[ei] = max(0.0, (req_soc - ev_soc) * ev_cap)
                for k in range(H):
                    if k < tau:
                        ev_gain[ei, k] = max_p
                        ev_c1_coeff[ei, k] = max_p * self.ev_efficiency

            # Compute frozen EV power: exact CityLearn charging replication for k=0
            frozen_ev_power = np.zeros((self._nb, H))
            if self.freeze_ev:
                for ei, evc in enumerate(self._mapping["ev_chargers"]):
                    b_idx = evc["b_idx"]
                    gidx_ev = evc["gidx"]
                    prop_act = float(proposed_flat[gidx_ev]) if gidx_ev < len(proposed_flat) else 0.0
                    if prop_act <= 0:
                        continue
                    chargers_list = getattr(buildings[b_idx], "electric_vehicle_chargers", [])
                    ev_in_bldg = [e for e in self._mapping["ev_chargers"] if e["b_idx"] == b_idx]
                    local_idx = next((li for li, e in enumerate(ev_in_bldg) if e["gidx"] == gidx_ev), None)
                    if local_idx is None or local_idx >= len(chargers_list):
                        continue
                    ch = chargers_list[local_idx]
                    ev_obj = getattr(ch, "connected_electric_vehicle", None)
                    if ev_obj is None:
                        continue
                    batt = getattr(ev_obj, "battery", None)
                    if batt is None:
                        continue
                    max_cp = float(getattr(ch, "max_charging_power", 0) or 0)
                    if isinstance(max_cp, np.ndarray): max_cp = float(max_cp.ravel()[0])
                    min_cp = float(getattr(ch, "min_charging_power", 0) or 0)
                    if isinstance(min_cp, np.ndarray): min_cp = float(min_cp.ravel()[0])
                    eff = 1.0
                    try: eff = ch.get_efficiency(abs(prop_act), True)
                    except: eff = 0.95
                    ev_cap = float(getattr(batt, "capacity", 0) or 0)
                    ev_rte = float(getattr(batt, "round_trip_efficiency", 1.0) or 1.0)
                    ev_loss = float(getattr(batt, "loss_coefficient", 0.0) or 0.0)
                    ev_soc_arr = np.asarray(getattr(batt, "soc", []), dtype=float)
                    ev_soc = float(ev_soc_arr[t_idx]) if 0 <= t_idx < len(ev_soc_arr) else 0.0
                    ev_soc = max(0.0, min(1.0, ev_soc))
                    if ev_cap <= 0: continue
                    power = prop_act * max_cp
                    energy = max(min(power, max_cp), min_cp)
                    energy_kwh = energy * eff
                    energy_init = ev_soc * ev_cap * (1.0 - ev_loss)
                    energy_final = min(energy_init + energy_kwh * ev_rte, ev_cap)
                    energy_balance = (energy_final - energy_init) / ev_rte if ev_rte > 0 else 0.0
                    elec_consumption = energy_balance / eff if eff > 0 else 0.0
                    elec_consumption = max(0.0, elec_consumption)
                    frozen_ev_power[b_idx, 0] += elec_consumption
                    # k>0: use same estimate while EV still connected
                    for k in range(1, H):
                        if ev_gain[ei, k] > 0:
                            frozen_ev_power[b_idx, k] += elec_consumption
                # Zero out ev_gain so QP's a_ev variable has no effect
                ev_gain = np.zeros_like(ev_gain)
                ev_c1_coeff = np.zeros_like(ev_c1_coeff)
                ev_deficit = np.zeros_like(ev_deficit)

            self._p_frozen_ev_power.value = frozen_ev_power
            self._p_ev_gain.value = ev_gain
            self._p_ev_c1_coeff.value = ev_c1_coeff
            self._p_ev_deficit.value = ev_deficit
            self._p_proposed_ev.value = proposed_ev

        # Adaptive C4 correction: tighten grid limit based on past error
        correction = max(0.0, self._grid_error_ema)  # static floor of 4 kW + adaptive
        effective_limit = max(10.0, self.p_grid_max - correction)  # floor at 10 kW
        self._p_grid_limit.value = float(effective_limit)

        # Solve
        status = "unknown"
        try:
            self._prob.solve(solver=cp.OSQP, warm_start=True, verbose=False,
                             max_iter=5000, eps_abs=1e-3, eps_rel=1e-3)
            status = str(self._prob.status)
        except Exception as ex:
            status = "solve_error: %s" % str(ex)[:80]

        solve_ms = (time.time() - t0) * 1000.0
        corrected = proposed_flat.copy()
        is_optimal = status in ("optimal", "optimal_inaccurate")
        interventions = {"any": False, "ev": 0, "batt": 0, "grid": 0}

        if is_optimal and self._v_a_batt.value is not None:
            for bi, (b_idx, gidx) in enumerate(self._batt_list):
                new_val = float(np.clip(self._v_a_batt.value[bi, 0], -1.0, 1.0))
                old_val = corrected[gidx]
                corrected[gidx] = new_val
                if abs(new_val - old_val) > 1e-4:
                    interventions["batt"] += 1
                    interventions["any"] = True
            if self._max_ev > 0 and self._v_a_ev is not None and self._v_a_ev.value is not None and not self.freeze_ev:
                for ei, evc in enumerate(self._mapping["ev_chargers"]):
                    g = evc["gidx"]
                    if 0 <= g < len(corrected):
                        new_val = float(np.clip(self._v_a_ev.value[ei, 0], 0.0, 1.0))
                        old_val = corrected[g]
                        corrected[g] = new_val
                        if abs(new_val - old_val) > 1e-4:
                            interventions["ev"] += 1
                            interventions["any"] = True
            interventions["grid"] = interventions["batt"] + interventions["ev"]

        info = {"psf_active": 1.0, "psf_any_intervention": interventions["any"],
                "psf_ev_interventions": interventions["ev"],
                "psf_battery_interventions": interventions["batt"],
                "psf_grid_interventions": interventions["grid"],
                "psf_solve_ms": solve_ms, "psf_status": status,
                "psf_infeasible": 0.0 if is_optimal else 1.0,
                "psf_action_delta_l2": float(np.linalg.norm(corrected - proposed_flat))}
        return corrected, info


    def _compute_c1_min_actions(self, action_flat):
        """Pre-QP: compute minimum EV actions for C1 (departure deadline).
        Returns dict {gidx_ev: min_action} for all connected EVs.
        Called BEFORE _update_params_and_solve so freeze_ev sees real EV power."""
        mins = {}
        if self._mapping is None:
            return mins
        city = self._get_citylearn_env()
        buildings = list(getattr(city, "buildings", []))
        t_now = int(getattr(city, "time_step", 0))
        t_idx = max(0, t_now - 1)
        import numpy as np

        for ei, evc in enumerate(self._mapping["ev_chargers"]):
            b_idx = evc["b_idx"]
            gidx_ev = evc["gidx"]
            if gidx_ev < 0 or gidx_ev >= len(action_flat) or b_idx >= len(buildings):
                continue
            chargers_list = getattr(buildings[b_idx], "electric_vehicle_chargers", [])
            ev_in_bldg = [e for e in self._mapping["ev_chargers"] if e["b_idx"] == b_idx]
            local_idx = next((li for li, e in enumerate(ev_in_bldg) if e["gidx"] == gidx_ev), None)
            if local_idx is None or local_idx >= len(chargers_list):
                continue
            ch = chargers_list[local_idx]
            ev_obj = getattr(ch, "connected_electric_vehicle", None)
            if ev_obj is None:
                continue
            batt = getattr(ev_obj, "battery", None)
            if batt is None:
                continue
            sim = getattr(ch, "charger_simulation",
                          getattr(ch, "_Charger__charger_simulation", None))
            if sim is None:
                continue
            try:
                state_arr = np.asarray(getattr(sim, "_electric_vehicle_charger_state"), dtype=float)
                dep_arr = np.asarray(getattr(sim, "_electric_vehicle_departure_time"), dtype=float)
                req_soc_arr = np.asarray(getattr(sim, "_electric_vehicle_required_soc_departure"), dtype=float)
                if t_now >= len(state_arr) or float(state_arr[t_now]) != 1.0:
                    continue
                dep_hours = float(dep_arr[t_now])
                req_soc = float(req_soc_arr[t_now])
            except Exception:
                continue
            if not np.isfinite(dep_hours) or dep_hours <= 0:
                mins[gidx_ev] = 0.01
                continue
            if not np.isfinite(req_soc):
                req_soc = 1.0
            ev_soc_arr = np.asarray(batt.soc, dtype=float)
            ev_soc = float(ev_soc_arr[t_idx]) if 0 <= t_idx < len(ev_soc_arr) else 0.0
            ev_soc = max(0.0, min(1.0, ev_soc))
            ev_cap = float(getattr(batt, "capacity", 0) or 0)
            if ev_cap <= 0:
                mins[gidx_ev] = 0.01
                continue
            max_cp = float(getattr(ch, "max_charging_power", 0) or 0)
            if isinstance(max_cp, np.ndarray):
                max_cp = float(max_cp.ravel()[0])
            if max_cp <= 0:
                mins[gidx_ev] = 0.01
                continue
            eff = 0.95
            try:
                eff = ch.get_efficiency(1.0, True)
            except Exception:
                pass
            ev_rte = float(getattr(batt, "round_trip_efficiency", 1.0) or 1.0)
            loss_c = float(getattr(batt, "loss_coefficient", 0.006) or 0.006)
            energy_per_hour = max_cp * eff * ev_rte
            T = max(1.0, dep_hours)
            decay = (1.0 - loss_c) ** T
            sum_geo = (1.0 - decay) / max(loss_c, 1e-9)
            soc_at_T_no_charge = ev_soc * decay
            needed_soc = req_soc - soc_at_T_no_charge
            if needed_soc <= 0:
                # Maintenance action: offset loss_coefficient decay each step
                # Loss per step = soc * loss_c * capacity (kWh)
                # Need action such that: action * max_cp * eff * rte >= soc * loss_c * cap
                loss_per_step = ev_soc * loss_c * ev_cap
                if energy_per_hour > 0:
                    maintain_action = loss_per_step / energy_per_hour
                    maintain_action *= 1.5  # 50% margin for model mismatch
                    maintain_action = max(0.01, min(0.3, maintain_action))
                else:
                    maintain_action = 0.05
                mins[gidx_ev] = maintain_action
                continue
            if energy_per_hour > 0 and sum_geo > 0:
                min_action = (needed_soc * ev_cap) / (energy_per_hour * sum_geo)
                min_action *= 1.3
                min_action = max(0.01, min(1.0, min_action))
            else:
                min_action = 1.0
            mins[gidx_ev] = min_action
        return mins

    def step(self, action):
        if not self._compiled:
            self._compile_qp()

        # flatten action (supports list-of-arrays or flat array)
        is_multi = isinstance(self.action_space, list)
        if is_multi:
            action_flat = np.concatenate([np.asarray(a, dtype=float).ravel() for a in action])
        else:
            action_flat = np.asarray(action, dtype=float).ravel()

        # --- PRE-QP C1 CLAMP: so freeze_ev sees realistic EV power ---
        if self._mapping is not None:
            c1_mins = self._compute_c1_min_actions(action_flat)
            for gidx_ev, min_act in c1_mins.items():
                action_flat[gidx_ev] = max(float(action_flat[gidx_ev]), min_act)

        corrected_flat, psf_info = self._update_params_and_solve(action_flat)

        # --- POST_SOLVE_SOC_CLAMP (guarantee C2) ---
        try:
            city = self._get_citylearn_env()
            t_now = int(getattr(city, "time_step", 0))
            t_idx = max(0, t_now - 1)

            soc_low = float(os.environ.get("CITYLEARN_STEMS_SOC_LOW", str(self.soc_low)))
            soc_high = float(os.environ.get("CITYLEARN_STEMS_SOC_HIGH", str(self.soc_high)))

            buildings = list(getattr(city, "buildings", []))
            for (b_idx, gidx) in self._batt_list:
                if gidx < 0 or gidx >= len(corrected_flat) or b_idx >= len(buildings):
                    continue
                es = getattr(buildings[b_idx], "electrical_storage", None)
                if es is None:
                    continue

                soc = 0.5
                soc_series = getattr(es, "soc", None)
                if soc_series is not None and hasattr(soc_series, "__len__"):
                    soc_arr = np.asarray(soc_series, dtype=float)
                    if 0 <= t_idx < len(soc_arr):
                        soc = float(np.clip(soc_arr[t_idx], 0.0, 1.0))
                    elif len(soc_arr) > 0:
                        soc = float(np.clip(soc_arr[-1], 0.0, 1.0))

                cap = float(getattr(es, "capacity", 6.4))
                nom_p = float(getattr(es, "nominal_power", 5.0))
                if cap <= 0 or nom_p <= 0:
                    continue

                scale = nom_p / cap
                a_min = max((soc_low - soc) / scale, -1.0)
                a_max = min((soc_high - soc) / scale, 1.0)
                corrected_flat[gidx] = float(np.clip(corrected_flat[gidx], a_min, a_max))
        except Exception:
            pass

        # --- POST_SOLVE_C3_CLAMP (exact EV power replication, respects C2) ---
        try:
            p_bld_clamp = float(os.environ.get("CITYLEARN_STEMS_P_BUILDING_MAX", "3.47"))
            base_net_k0 = self._p_base_net.value[:, 0]
            batt_gain_arr = self._p_batt_gain.value
            soc_low_c = float(os.environ.get("CITYLEARN_STEMS_SOC_LOW", str(self.soc_low)))
            soc_high_c = float(os.environ.get("CITYLEARN_STEMS_SOC_HIGH", str(self.soc_high)))
            # Compute exact EV power by replicating CityLearn's charging math
            exact_ev = np.zeros(self._nb)
            if self._max_ev > 0 and self.freeze_ev:
                for ei, evc in enumerate(self._mapping["ev_chargers"]):
                    b_idx = evc["b_idx"]
                    gidx_ev = evc["gidx"]
                    prop_act = float(action_flat[gidx_ev]) if gidx_ev < len(action_flat) else 0.0
                    if prop_act <= 0:
                        continue
                    chargers_list = getattr(buildings[b_idx], "electric_vehicle_chargers", [])
                    ev_in_bldg = [e for e in self._mapping["ev_chargers"] if e["b_idx"] == b_idx]
                    local_idx = next((li for li, e in enumerate(ev_in_bldg) if e["gidx"] == gidx_ev), None)
                    if local_idx is None or local_idx >= len(chargers_list):
                        continue
                    ch = chargers_list[local_idx]
                    ev_obj = getattr(ch, "connected_electric_vehicle", None)
                    if ev_obj is None:
                        continue
                    batt = getattr(ev_obj, "battery", None)
                    if batt is None:
                        continue
                    # Read charger params
                    max_cp = float(getattr(ch, "max_charging_power", 0) or 0)
                    if isinstance(max_cp, np.ndarray):
                        max_cp = float(max_cp.ravel()[0])
                    min_cp = float(getattr(ch, "min_charging_power", 0) or 0)
                    if isinstance(min_cp, np.ndarray):
                        min_cp = float(min_cp.ravel()[0])
                    # Charger efficiency (approximate: use ~0.95 or read from curve)
                    eff = 1.0
                    try:
                        eff = ch.get_efficiency(abs(prop_act), True)
                    except Exception:
                        eff = 0.95
                    # Read EV battery params
                    ev_cap = float(getattr(batt, "capacity", 0) or 0)
                    ev_rte = float(getattr(batt, "round_trip_efficiency", 1.0) or 1.0)
                    ev_loss = float(getattr(batt, "loss_coefficient", 0.0) or 0.0)
                    ev_soc_arr = np.asarray(getattr(batt, "soc", []), dtype=float)
                    ev_soc = float(ev_soc_arr[t_idx]) if 0 <= t_idx < len(ev_soc_arr) else 0.0
                    ev_soc = max(0.0, min(1.0, ev_soc))
                    if ev_cap <= 0:
                        continue
                    # Replicate CityLearn's charging math
                    power = prop_act * max_cp
                    energy = max(min(power, max_cp), min_cp)
                    energy_kwh = energy * eff
                    energy_init = ev_soc * ev_cap * (1.0 - ev_loss)
                    energy_final = min(energy_init + energy_kwh * ev_rte, ev_cap)
                    energy_balance = (energy_final - energy_init) / ev_rte if ev_rte > 0 else 0.0
                    elec_consumption = energy_balance / eff if eff > 0 else 0.0
                    exact_ev[b_idx] += max(0.0, elec_consumption)
            for bi, (b_idx, gidx) in enumerate(self._batt_list):
                bg = batt_gain_arr[bi]
                if bg <= 0:
                    continue
                uncontrolled = base_net_k0[b_idx] + exact_ev[b_idx]
                current_a = corrected_flat[gidx]
                predicted_net = uncontrolled + current_a * bg
                if abs(predicted_net) > p_bld_clamp:
                    if predicted_net > p_bld_clamp:
                        a_c3 = (p_bld_clamp - uncontrolled) / bg
                    else:
                        a_c3 = (-p_bld_clamp - uncontrolled) / bg
                    es = getattr(buildings[b_idx], "electrical_storage", None)
                    if es is not None:
                        soc_s = getattr(es, "soc", None)
                        soc_v = 0.5
                        if soc_s is not None and hasattr(soc_s, "__len__"):
                            soc_a = np.asarray(soc_s, dtype=float)
                            if 0 <= t_idx < len(soc_a):
                                soc_v = float(np.clip(soc_a[t_idx], 0.0, 1.0))
                            elif len(soc_a) > 0:
                                soc_v = float(np.clip(soc_a[-1], 0.0, 1.0))
                        cap = float(getattr(es, "capacity", 6.4))
                        nom = float(getattr(es, "nominal_power", 5.0))
                        sc = nom / cap if cap > 0 else 1.0
                        a_lo = max((soc_low_c - soc_v) / sc, -1.0)
                        a_hi = min((soc_high_c - soc_v) / sc, 1.0)
                        corrected_flat[gidx] = float(np.clip(a_c3, a_lo, a_hi))
        except Exception:
            pass


        # --- POST_SOLVE_C4_CLAMP (reduce grid power by adjusting batteries) ---
        try:
            p_grid_clamp = float(os.environ.get("CITYLEARN_STEMS_P_GRID_MAX", str(self.p_grid_max)))
            soc_low_c4 = float(os.environ.get("CITYLEARN_STEMS_SOC_LOW", str(self.soc_low)))
            soc_high_c4 = float(os.environ.get("CITYLEARN_STEMS_SOC_HIGH", str(self.soc_high)))
            base_net_k0_c4 = self._p_base_net.value[:, 0]
            batt_gain_c4 = self._p_batt_gain.value

            # Compute predicted grid power = sum of (base_net + batt*gain + ev) per building
            total_grid = 0.0
            bldg_nets = []
            for bi, (b_idx, gidx) in enumerate(self._batt_list):
                bg = batt_gain_c4[bi] if batt_gain_c4.ndim == 1 else batt_gain_c4[bi, 0]
                net_i = base_net_k0_c4[b_idx] + float(corrected_flat[gidx]) * bg
                bldg_nets.append(net_i)
            # Add buildings without batteries
            for b_idx in range(self._nb):
                if b_idx not in [bl[0] for bl in self._batt_list]:
                    bldg_nets.append(float(base_net_k0_c4[b_idx]))
            total_grid = sum(bldg_nets)

            if abs(total_grid) > p_grid_clamp:
                excess = total_grid - (p_grid_clamp if total_grid > 0 else -p_grid_clamp)
                # Distribute discharge (or charge reduction) across all batteries
                n_batt = len(self._batt_list)
                if n_batt > 0:
                    per_batt = excess / n_batt
                    for bi, (b_idx, gidx) in enumerate(self._batt_list):
                        bg = batt_gain_c4[bi] if batt_gain_c4.ndim == 1 else batt_gain_c4[bi, 0]
                        if bg <= 0:
                            continue
                        delta_action = per_batt / bg
                        new_action = float(corrected_flat[gidx]) - delta_action
                        # Respect C2 bounds
                        es = getattr(buildings[b_idx], "electrical_storage", None)
                        if es is not None:
                            soc_s = getattr(es, "soc", None)
                            soc_v = 0.5
                            if soc_s is not None and hasattr(soc_s, "__len__"):
                                soc_a = np.asarray(soc_s, dtype=float)
                                if 0 <= t_idx < len(soc_a):
                                    soc_v = float(np.clip(soc_a[t_idx], 0.0, 1.0))
                            cap_c4 = float(getattr(es, "capacity", 6.4))
                            nom_c4 = float(getattr(es, "nominal_power", 5.0))
                            sc_c4 = nom_c4 / cap_c4 if cap_c4 > 0 else 1.0
                            a_lo = max((soc_low_c4 - soc_v) / sc_c4, -1.0)
                            a_hi = min((soc_high_c4 - soc_v) / sc_c4, 1.0)
                            corrected_flat[gidx] = float(np.clip(new_action, a_lo, a_hi))
        except Exception:
            pass

        # --- POST_SOLVE_C1_SAFETY_NET (lightweight: enforce pre-QP mins on corrected) ---
        # Real C1 work done pre-QP. This ensures QP didn't zero out EVs.
        try:
            if self._mapping is not None:
                c1_mins_post = self._compute_c1_min_actions(corrected_flat)
                for gidx_ev, min_act in c1_mins_post.items():
                    if corrected_flat[gidx_ev] < min_act:
                        corrected_flat[gidx_ev] = min_act
        except Exception:
            pass

        corrected_action = unflatten_action(corrected_flat, self.action_space) if is_multi else corrected_flat
        obs, reward, term, trunc, info = self.env.step(corrected_action)
        info.update(psf_info)

        # bookkeeping
        self._step_count += 1
        if psf_info.get("psf_any_intervention", False):
            self._total_interventions += 1
        self._total_ev_interventions += psf_info.get("psf_ev_interventions", 0)
        self._total_batt_interventions += psf_info.get("psf_battery_interventions", 0)
        self._total_grid_interventions += psf_info.get("psf_grid_interventions", 0)

        # --- ADAPTIVE C4: track prediction error ---
        try:
            city_post = self._get_citylearn_env()
            buildings_post = list(getattr(city_post, "buildings", []))
            actual_grid = 0.0
            for b in buildings_post:
                ti_post = max(0, b.time_step - 1)
                if ti_post < len(b.net_electricity_consumption):
                    actual_grid += b.net_electricity_consumption[ti_post]
            # Compute what QP predicted for grid power
            predicted_grid = 0.0
            base_net_vals = self._p_base_net.value[:, 0]
            frozen_ev_vals = self._p_frozen_ev_power.value[:, 0] if self._max_ev > 0 else np.zeros(self._nb)
            bg_vals = self._p_batt_gain.value
            for bi, (b_idx_t, gidx_t) in enumerate(self._batt_list):
                try:
                    qp_act = float(self._v_a_batt.value[bi, 0]) if self._v_a_batt.value is not None else 0.0
                except:
                    qp_act = 0.0
                predicted_grid += base_net_vals[b_idx_t] + frozen_ev_vals[b_idx_t] + qp_act * bg_vals[bi]
            for b_idx_t in range(self._nb):
                if b_idx_t not in [bl[0] for bl in self._batt_list]:
                    predicted_grid += base_net_vals[b_idx_t] + frozen_ev_vals[b_idx_t]
            error = abs(actual_grid) - abs(predicted_grid)  # positive = QP underestimated severity
            alpha = 0.7
            self._grid_error_ema = alpha * error + (1.0 - alpha) * self._grid_error_ema
        except Exception:
            pass
        self._total_solve_ms += psf_info.get("psf_solve_ms", 0)
        if psf_info.get("psf_infeasible", 0) > 0:
            self._infeasible_count += 1

        if self.verbose >= 1 and self._step_count % 500 == 0:
            avg_ms = self._total_solve_ms / max(1, self._step_count)
            print("[PSF-QP] step=%d interventions=%d infeasible=%d avg_solve=%.1fms" % (
                self._step_count, self._total_interventions, self._infeasible_count, avg_ms))

        return obs, reward, term, trunc, info


    def reset(self, **kwargs):
        if self._step_count > 0 and self.verbose >= 1:
            avg_ms = self._total_solve_ms / max(1, self._step_count)
            print("[PSF-QP] Episode done | steps=%d interventions=%d "
                  "(ev=%d batt=%d) infeasible=%d avg_solve=%.1fms" % (
                      self._step_count, self._total_interventions,
                      self._total_ev_interventions, self._total_batt_interventions,
                      self._infeasible_count, avg_ms))
        self._step_count = 0
        self._episode_count += 1
        self._total_interventions = 0
        self._total_ev_interventions = 0
        self._total_batt_interventions = 0
        self._total_grid_interventions = 0
        self._total_solve_ms = 0.0
        self._infeasible_count = 0
        self._compiled = False
        return self.env.reset(**kwargs)
